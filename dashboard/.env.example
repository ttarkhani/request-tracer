# Copy to .env.local (dev) or set in Vercel → Project Settings → Environment Variables.
# All optional. With none set, production builds run in demo mode with zero network calls.

# Log aggregator base URL. `npm run dev` falls back to http://localhost:8084 when unset.
# VITE_AGGREGATOR_URL=https://aggregator.example.com

# API gateway base URL. Only set this if the gateway allows CORS from the dashboard's
# origin and returns the trace ID (exposed X-Trace-Id header or `traceId` body field).
# VITE_GATEWAY_URL=https://gateway.example.com

# Public URL of the deployed dashboard, for absolute Open Graph image links.
# Not needed on Vercel (VERCEL_PROJECT_PRODUCTION_URL is used automatically).
# VITE_SITE_URL=https://request-tracer.vercel.app
